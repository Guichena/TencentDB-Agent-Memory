{
  "name": "context-proxy",
  "version": "0.1.0",
  "description": "Lightweight LLM request forwarding proxy with JSONL logging and Opik tracing",
  "type": "module",
  "scripts": {
    "start": "node --import tsx/esm src/index.ts",
    "start:config": "node --import tsx/esm src/index.ts --config config.yaml",
    "dev": "node --import tsx/esm --watch src/index.ts",
    "dev:config": "node --import tsx/esm --watch src/index.ts --config config.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval:tool-prompt:generate": "tsx eval/tool-prompt-bench/generate.ts",
    "eval:tool-prompt:capture-c00": "tsx eval/tool-prompt-bench/capture-profile-artifacts.ts C00",
    "eval:tool-prompt:capture-c01": "tsx eval/tool-prompt-bench/capture-profile-artifacts.ts C01",
    "eval:tool-prompt:capture-c02": "tsx eval/tool-prompt-bench/capture-profile-artifacts.ts C02",
    "eval:tool-prompt:capture-c03": "tsx eval/tool-prompt-bench/capture-profile-artifacts.ts C03",
    "eval:tool-prompt:capture-c04": "tsx eval/tool-prompt-bench/capture-profile-artifacts.ts C04",
    "eval:tool-prompt:capture-c05": "tsx eval/tool-prompt-bench/capture-profile-artifacts.ts C05",
    "eval:tool-prompt:capture-freeze": "tsx eval/tool-prompt-bench/capture-code-freeze.ts",
    "eval:tool-prompt:validate": "tsx eval/tool-prompt-bench/validate.ts",
    "eval:tool-prompt:test": "vitest run src/__tests__/tool-prompt-bench.test.ts",
    "eval:tool-prompt:real-chain:gate": "vitest run src/__tests__/real-chain-adapter.test.ts",
    "eval:tool-prompt:d0:test": "vitest run src/__tests__/formal-world-schema.test.ts src/__tests__/formal-visibility.test.ts src/__tests__/formal-snapshot.test.ts src/__tests__/formal-provenance.test.ts src/__tests__/formal-evaluator-contract.test.ts src/__tests__/formal-dataset-registry.test.ts src/__tests__/formal-measurement-v2-overlay.test.ts src/__tests__/tool-prompt-canonical-json-shared.test.ts && python -m unittest discover -s eval/tool-prompt-bench/source-tools/tests -q",
    "eval:tool-prompt:formal:gate": "vitest run --maxWorkers=1 --minWorkers=1 src/__tests__/formal-profile-override.test.ts src/__tests__/formal-runtime.test.ts src/__tests__/formal-runtime-bindings.test.ts src/__tests__/formal-private-measurement.test.ts src/__tests__/formal-smoke-preregistration.test.ts src/__tests__/formal-runtime-freeze.test.ts src/__tests__/formal-public-datasource.test.ts src/__tests__/formal-prepare-datasource.test.ts src/__tests__/formal-prepare-runner.test.ts src/__tests__/formal-prepare-entry.test.ts",
    "eval:tool-prompt:formal:r03:gate": "vitest run --maxWorkers=1 --minWorkers=1 src/__tests__/real-chain-adapter.test.ts src/__tests__/tool-execution-completion-observer.test.ts src/__tests__/formal-execution-preflight.test.ts src/__tests__/formal-asset-restore-plan.test.ts src/__tests__/formal-asset-restore-plan-contract.test.ts src/__tests__/formal-build-frozen-restore-plan.test.ts src/__tests__/formal-asset-restore-runtime.test.ts",
    "eval:tool-prompt:formal:build-restore-plan": "tsx eval/tool-prompt-bench/formal-dataset/scripts/build-formal-restore-plan.ts",
    "eval:tool-prompt:formal:restore-assets": "tsx eval/tool-prompt-bench/formal-dataset/scripts/restore-formal-snapshot.ts",
    "eval:tool-prompt:formal:inspect-assets": "tsx eval/tool-prompt-bench/formal-dataset/scripts/inspect-formal-snapshot.ts",
    "eval:tool-prompt:formal:prepare": "tsx eval/tool-prompt-bench/formal-prepare-cli.ts",
    "eval:tool-prompt:formal:freeze-runtime": "tsx eval/tool-prompt-bench/formal-runtime/freeze-formal-runtime.ts",
    "eval:tool-prompt:formal:coverage": "tsx eval/tool-prompt-bench/formal-dataset/scripts/build-formal-v21-coverage.ts",
    "eval:tool-prompt:formal:capture-r02-freeze": "tsx eval/tool-prompt-bench/formal-runtime/capture-r02-experiment-freeze.ts",
    "eval:tool-prompt:measurement-v2:gate": "vitest run --config eval/tool-prompt-bench/measurement-v2/vitest.config.ts && tsc -p eval/tool-prompt-bench/measurement-v2/tsconfig.json",
    "eval:tool-prompt:formal:r05:gate": "vitest run --maxWorkers=1 --minWorkers=1 src/__tests__/auth.test.ts src/__tests__/formal-production-restore-executor.test.ts src/__tests__/formal-server-team-production-requirements.test.ts src/__tests__/formal-server-team-production-transport.test.ts src/__tests__/formal-server-team-memory-import-client.test.ts src/__tests__/formal-server-team-production-adapter.test.ts src/__tests__/formal-server-team-production-inspector.test.ts src/__tests__/formal-benchmark-memory-import.test.ts src/__tests__/formal-benchmark-preflight-session.test.ts src/__tests__/formal-execution-preflight.test.ts src/__tests__/formal-asset-restore-plan.test.ts src/__tests__/formal-asset-restore-runtime.test.ts src/__tests__/formal-dataset-registry.test.ts src/__tests__/formal-build-frozen-restore-plan.test.ts src/__tests__/formal-asset-restore-plan-contract.test.ts src/__tests__/formal-r05-runtime-preflight-script.test.ts",
    "eval:tool-prompt:integration:gate": "npm run eval:tool-prompt:d0:test && npm run eval:tool-prompt:test && vitest run src/__tests__/formal-selection-contract.test.ts src/__tests__/provisional-measurement-v2-freeze.test.ts src/__tests__/tool-prompt-pair-v2.test.ts src/__tests__/formal-collect-score-cli.test.ts src/__tests__/formal-cache-structure-gate.test.ts src/__tests__/formal-execution-cli.test.ts src/__tests__/provider-evidence-collector.test.ts src/__tests__/provider-request-trace-sink.test.ts src/__tests__/observed-event-collector.test.ts src/__tests__/formal-preflight-receipt-cli.test.ts && npm run eval:tool-prompt:measurement-v2:gate && npm run eval:tool-prompt:formal:r05:gate && npm run eval:tool-prompt:formal:r03:gate && npm run eval:tool-prompt:formal:gate",
    "eval:tool-prompt:capture-provisional-freeze": "tsx eval/tool-prompt-bench/measurement-v2/build-provisional-freeze-manifest.ts",
    "eval:tool-prompt:score": "tsx eval/tool-prompt-bench/score.ts",
    "eval:tool-prompt:codex": "tsx eval/tool-prompt-bench/codex-runner.ts"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0",
    "cos-nodejs-sdk-v5": "^3.0.0"
  },
  "dependencies": {
    "@clickhouse/client": "^1.22.0",
    "@hono/node-server": "^1.13.7",
    "@langfuse/otel": "^5.9.0",
    "@langfuse/tracing": "^5.9.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.202.0 <1.0.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "hono": "^4.7.10",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.29",
    "tiktoken": "^1.0.22",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
