  "l3_profile":{"asset_id":"T20-L3-SEARCH-ENGINEERING-PREFERENCES","status":"stable","owner":{"agent_id":"agent-task1-t20-general","name":"T20 通用业务 Agent"},"content":{"long_lived_preferences":["偏好先区分映射、查询、排序、分页和索引切换边界，再讨论实现。","偏好保留失败尝试、改向理由、跨会话引用和可回退点。","偏好以固定样本和可复现证据核对检索质量。"],"general_constraints":["变更需保留可逆路径并按阶段观察。","同域项目和旁支指标必须明确分组。","不从平均指标或单次成功样本推断最终工程决定。"]}}
