      "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"},
      "messages": [
        {"message_id": "t19-msg-key-ceremony-001", "role": "user", "content": "KeyTurn 要进行签名键轮换演练，先排列准备、重叠、切换和回退步骤。"},
        {"message_id": "t19-msg-key-ceremony-002", "role": "assistant", "content": "我会把发布新键、验证读取、切换签发和撤回旧键分别记录。"},
        {"message_id": "t19-msg-key-ceremony-003", "role": "user", "content": "第一次先撤旧键再发新键，验证节点立刻出现失败。"},
        {"message_id": "t19-msg-key-ceremony-004", "role": "assistant", "content": "修正为先发布新键并观察读取，再切换签发，最后才撤旧键。"},
        {"message_id": "t19-msg-key-ceremony-005", "role": "user", "content": "第二次步骤顺序正确，但读取角色在部分节点没有新键权限。"},
        {"message_id": "t19-msg-key-ceremony-006", "role": "assistant", "content": "把读取权限检查提前到演练门槛，拒绝把写入权限作为临时补丁。"},
        {"message_id": "t19-msg-key-ceremony-007", "role": "user", "content": "WorkloadTrust 的服务身份刷新会同时发生，需要单独标注调用来源。"},
        {"message_id": "t19-msg-key-ceremony-008", "role": "assistant", "content": "已把服务身份刷新作为并行观察，不改变键轮换步骤。"},
        {"message_id": "t19-msg-key-ceremony-009", "role": "user", "content": "跨会话演练要求每个阶段有可检查的进入和退出条件。"},
        {"message_id": "t19-msg-key-ceremony-010", "role": "assistant", "content": "每一阶段都增加双人确认和可回退开关。"},
        {"message_id": "t19-msg-key-ceremony-011", "role": "user", "content": "最终复盘要保留失败步骤与修正理由。"},
        {"message_id": "t19-msg-key-ceremony-012", "role": "assistant", "content": "演练记录已包含失败尝试、权限检查和回退演示，供后续轮换复用。"}
      ]
    },
    {
      "asset_id": "T19-L0-KEY-PERMISSION-REGRESSION",
      "session_id": "t19-session-key-permission-010",
      "project": "KeyTurn",
      "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"},
      "messages": [
        {"message_id": "t19-msg-key-perm-001", "role": "user", "content": "KeyTurn 的权限回归阻塞轮换，读取新旧键的服务在一小段时间内得到不同结果。"},
        {"message_id": "t19-msg-key-perm-002", "role": "assistant", "content": "我会分别核对重叠窗口、读取角色和租户绑定，避免用时间参数掩盖权限问题。"},
        {"message_id": "t19-msg-key-perm-003", "role": "user", "content": "第一次只延长重叠窗口，错误仍在；第二次临时给所有服务写权限，测试虽绿但不合规。"},
        {"message_id": "t19-msg-key-perm-004", "role": "assistant", "content": "两次尝试都撤回，保留最小权限原则并追查读取角色的绑定。"},
        {"message_id": "t19-msg-key-perm-005", "role": "user", "content": "复现只发生在轮换读取角色，普通验证角色和写入角色不受影响。"},
        {"message_id": "t19-msg-key-perm-006", "role": "assistant", "content": "范围已收窄到该读取角色与两把轮换键的权限关系。"},
        {"message_id": "t19-msg-key-perm-007", "role": "user", "content": "TokenForge 的 JWKS 观察再次出现，但只涉及缓存状态。"},
        {"message_id": "t19-msg-key-perm-008", "role": "assistant", "content": "把缓存观察留在旁路报告，不把它当作 KeyTurn 授权根因。"},
        {"message_id": "t19-msg-key-perm-009", "role": "user", "content": "最后一次修复只给读取角色补齐新旧键读取授权，并保持写入拒绝。"},
        {"message_id": "t19-msg-key-perm-010", "role": "assistant", "content": "回归已覆盖旧键、新键、轮换中途和回滚，最小修复在四个阶段都稳定。"},
        {"message_id": "t19-msg-key-perm-011", "role": "user", "content": "复盘标题需要明确根因不是窗口长度。"},
        {"message_id": "t19-msg-key-perm-012", "role": "assistant", "content": "已在复盘中保留根因、权限边界和拒绝写入的修复约束。"}
      ]
    }
  ],
  "l1_memories": [
    {"asset_id": "T19-L1-ATLAS-REDIRECT-CANONICAL", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "AtlasGate 的规范回调地址只允许当前发布批次登记的来源；旧来源仅在过渡观测期间保留，状态参数必须与一次性会话绑定。", "support_links": [{"asset_id": "T19-L0-ATLAS-LOGIN-CUTOVER", "message_ids": ["t19-msg-atlas-login-002", "t19-msg-atlas-login-006"]}]},
    {"asset_id": "T19-L1-ATLAS-SESSION-CUTOVER", "status": "active", "owner": {"agent_id": "agent-task1-t19-identity-platform", "name": "身份平台 Agent"}, "content": "当前 AtlasGate 会话切换 cohort 是低风险租户中 25% 的活跃浏览器会话，先保持双回调观测；若新会话成功率连续 10 分钟低于 99.5% 或旧 cookie 回退率超过 0.8%，立即停止扩展并恢复旧回调路径。", "support_links": [{"asset_id": "T19-L0-ATLAS-LOGIN-CUTOVER", "message_ids": ["t19-msg-atlas-login-007", "t19-msg-atlas-login-010"]}, {"asset_id": "T19-L0-ATLAS-COOKIE-FALLBACK", "message_ids": ["t19-msg-atlas-cookie-011", "t19-msg-atlas-cookie-012"]}]},
    {"asset_id": "T19-L1-ATLAS-COOKIE-SAMESITE", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "会话 cookie 的跨站兼容只覆盖必要回调场景，必须启用安全传输并在新会话成功后定向失效旧名称，禁止全局放宽或长期双写。", "support_links": [{"asset_id": "T19-L0-ATLAS-COOKIE-FALLBACK", "message_ids": ["t19-msg-atlas-cookie-003", "t19-msg-atlas-cookie-006"]}]},
    {"asset_id": "T19-L1-TOKEN-ROTATION-GRACE", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "TokenForge retry grace is 90 seconds, only for idempotent retry of the same refresh token after an ambiguous gateway-timeout outcome; after the window, do not replay. The rationale is to cover the client/gateway retry ceiling while tightly limiting reuse exposure.", "support_links": [{"asset_id": "T19-L0-TOKEN-ROTATION-INCIDENT", "message_ids": ["t19-msg-token-incident-001", "t19-msg-token-incident-005"]}]},
    {"asset_id": "T19-L1-TOKEN-REVOCATION-SCOPE", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "刷新令牌撤销按客户端与会话范围执行；确认服务端已完成交换后，旧值不得再次提交，其他会话不会因单一会话撤销而被误伤。", "support_links": [{"asset_id": "T19-L0-TOKEN-ROTATION-INCIDENT", "message_ids": ["t19-msg-token-incident-007", "t19-msg-token-incident-008"]}]},
    {"asset_id": "T19-L1-TOKEN-JWKS-OVERLAP", "status": "active", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "TokenForge 的 JWKS 观察需要保留新旧键的短时验证重叠，节点按退避刷新；它只约束验证缓存，不改变刷新交换方式。", "support_links": [{"asset_id": "T19-L0-TOKEN-JWKS-OVERLAP", "message_ids": ["t19-msg-token-jwks-004", "t19-msg-token-jwks-010"]}]},
    {"asset_id": "T19-L1-TOKEN-ROLLBACK-BOUNDARY", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "令牌轮换异常时冻结扩展、恢复上一组验证配置并保留必要的键重叠；不得通过无限重试或全量刷新来掩盖不确定结果。", "support_links": [{"asset_id": "T19-L0-TOKEN-JWKS-OVERLAP", "message_ids": ["t19-msg-token-jwks-003", "t19-msg-token-jwks-012"]}, {"asset_id": "T19-L0-TOKEN-ROTATION-INCIDENT", "message_ids": ["t19-msg-token-incident-005", "t19-msg-token-incident-010"]}]},
    {"asset_id": "T19-L1-PERMIT-TENANT-DENY", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-policy-assurance", "name": "授权保障 Agent"}, "content": "PermitMesh 对缺少租户、错误租户、资源不存在和角色过期的请求保持拒绝，并为拒绝记录稳定的分层原因；跨租户处理必须有受审计的运维工单上下文。", "support_links": [{"asset_id": "T19-L0-PERMIT-TENANT-DENY", "message_ids": ["t19-msg-permit-deny-006", "t19-msg-permit-deny-010"]}]},
    {"asset_id": "T19-L1-PERMIT-SUBJECT-ATTRIBUTES", "status": "active", "owner": {"agent_id": "agent-task1-t19-policy-assurance", "name": "授权保障 Agent"}, "content": "授权主体必须显式携带请求租户、主体属性和资源归属；不能用角色名称或缓存默认值补齐缺失租户，也不能让登录来源替代租户边界。", "support_links": [{"asset_id": "T19-L0-PERMIT-TENANT-DENY", "message_ids": ["t19-msg-permit-deny-003", "t19-msg-permit-deny-008"]}]},
    {"asset_id": "T19-L1-PERMIT-REGRESSION-FIXTURE", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-policy-assurance", "name": "授权保障 Agent"}, "content": "PermitMesh 回归夹具覆盖旧角色、新角色、标签缺失和跨租户四组，并将读取和写入动作分开断言；缺失标签不视为通配。", "support_links": [{"asset_id": "T19-L0-PERMIT-ROLE-REGRESSION", "message_ids": ["t19-msg-permit-role-003", "t19-msg-permit-role-006", "t19-msg-permit-role-011"]}]},
    {"asset_id": "T19-L1-WORKLOAD-AUDIENCE", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "WorkloadTrust token exchange 必须精确接受 audience `urn:workloadtrust:token-exchange` 并绑定调用方服务身份；环境后缀、租户名和宽泛资源前缀均不接受。", "support_links": [{"asset_id": "T19-L0-WORKLOAD-FEDERATION", "message_ids": ["t19-msg-workload-fed-005", "t19-msg-workload-fed-006"]}]},
    {"asset_id": "T19-L1-WORKLOAD-TOKEN-EXCHANGE", "status": "active", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "服务间交换按声明来源、服务身份、精确受众三步校验，错误租户或错误受众在交换入口拒绝，短时令牌替代部署脚本中的长期凭证。", "support_links": [{"asset_id": "T19-L0-WORKLOAD-FEDERATION", "message_ids": ["t19-msg-workload-fed-002", "t19-msg-workload-fed-010"]}]},
    {"asset_id": "T19-L1-WORKLOAD-MTLS-IDENTITY", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "mTLS 轮换先完成证书链和连接池重连，再进入服务身份与令牌策略判断；分批排空连接，避免全量断开造成流量尖峰。", "support_links": [{"asset_id": "T19-L0-WORKLOAD-MTLS", "message_ids": ["t19-msg-workload-mtls-004", "t19-msg-workload-mtls-006"]}]},
    {"asset_id": "T19-L1-KEY-OVERLAP-WINDOW", "status": "active", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "KeyTurn 轮换顺序是先发布新键并确认读取，再切换签发，最后撤旧键；兼容观察结束前不得撤回仍被验证节点使用的旧键。", "support_links": [{"asset_id": "T19-L0-KEY-ROTATION-CEREMONY", "message_ids": ["t19-msg-key-ceremony-003", "t19-msg-key-ceremony-004"]}]},
    {"asset_id": "T19-L1-KEY-READER-PERMISSION", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "轮换读取角色只获得新旧键的读取授权，不能以临时写权限代替；权限门槛必须在演练进入前通过。", "support_links": [{"asset_id": "T19-L0-KEY-ROTATION-CEREMONY", "message_ids": ["t19-msg-key-ceremony-005", "t19-msg-key-ceremony-006"]}]},
    {"asset_id": "T19-L1-KEY-ROLLBACK-TRIGGER", "status": "confirmed", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "KeyTurn 任一阶段出现验证失败或读取权限缺失时，停止推进并恢复上一组签发配置；回退保留读取重叠，不授予通用写权限。", "support_links": [{"asset_id": "T19-L0-KEY-ROTATION-CEREMONY", "message_ids": ["t19-msg-key-ceremony-009", "t19-msg-key-ceremony-010"]}, {"asset_id": "T19-L0-KEY-PERMISSION-REGRESSION", "message_ids": ["t19-msg-key-perm-009", "t19-msg-key-perm-010"]}]}
  ],
  "l2_scenes": [
    {"asset_id": "T19-L2-ATLAS-CUTOVER", "path": "t19/atlasgate/session-cutover", "summary": "AtlasGate 会话切换场景，记录处于分批观测阶段。", "owner": {"agent_id": "agent-task1-t19-identity-platform", "name": "身份平台 Agent"}, "content": "场景记录包含切换前后会话建立、双回调观测、cookie 回退监测、失败样本分组和发布暂停动作。它将浏览器状态问题与令牌交换问题分开，并要求每个批次在扩大前完成稳定观察。"},
    {"asset_id": "T19-L2-TOKEN-LIFECYCLE", "path": "t19/tokenforge/lifecycle", "summary": "TokenForge 令牌生命周期调查场景，记录轮换与验证的联动状态。", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "场景内容对比刷新交换、令牌撤销、JWKS 缓存和回退观察的边界，保留网关超时后的失败实验与修正过程，但不把验证缓存现象当作刷新路径选择。"},
    {"asset_id": "T19-L2-PERMIT-DECISION", "path": "t19/permitmesh/decision-contract", "summary": "PermitMesh 租户授权契约场景，记录决策实现与审计状态。", "owner": {"agent_id": "agent-task1-t19-policy-assurance", "name": "授权保障 Agent"}, "content": "场景的正式决策顺序是：先确认主体身份与请求租户一致，再检查资源归属，随后评估角色和上下文策略，最后记录拒绝原因。只有平台运维主体在受审计的工单上下文中可跨租户处理，普通租户主体不得走这条例外。所有拒绝都保留分层原因。"},
    {"asset_id": "T19-L2-WORKLOAD-IDENTITY", "path": "t19/workloadtrust/federation", "summary": "WorkloadTrust 联邦身份场景，记录服务间交换的推进状态。", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "场景内容串联声明来源、mTLS 证书链、服务身份绑定和短时令牌交换的失败样本，展示从宽泛约束到精确契约的修正过程，并区分错误受众与证书过期。"},
    {"asset_id": "T19-L2-KEY-ROTATION", "path": "t19/keyturn/rotation", "summary": "KeyTurn 轮换准备场景，记录轮换处于可回退的准备状态。", "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"}, "content": "场景内容包括新旧键读取、签发切换、权限门槛、验证观测和回退演练，强调最小读取权限与失败即暂停的操作边界，并将 JWKS 旁路观察单独记账。"}
  ],
  "l3_profile": {
    "asset_id": "T19-L3-ENGINEERING-PREFERENCES",
    "status": "stable",
    "owner": {"agent_id": "agent-task1-t19-general", "name": "T19 通用业务 Agent"},
    "content": {
      "long_lived_preferences": ["偏好先拆分身份、授权、会话和令牌边界，再讨论实现。", "偏好保留失败尝试、修正理由和可回退点。", "偏好用可审计的分层原因说明安全决策。"],
      "general_constraints": ["遵循最小权限和默认拒绝。", "变更采用分批观察并保留可逆路径。", "测试不得记录秘密值，跨项目指标需明确分组。"]
    }
  }
}
